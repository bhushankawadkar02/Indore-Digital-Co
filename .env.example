# Instagram Graph API Integration (Optional)
# If provided, /api/instagram automatically pulls real-time followers,
# following count, media count, and latest reels directly from Meta's API.
# If omitted, the app smoothly uses the curated metrics in data/agency.ts.
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_api_long_lived_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_or_creator_account_id_here
